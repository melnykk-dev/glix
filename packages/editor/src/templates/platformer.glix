        {
          "id": "player",
          "name": "Player",
          "components": {
            "transform": {
              "x": -8,
              "y": 2,
              "rotation": 0,
              "scaleX": 1,
              "scaleY": 1
            },
            "sprite": {
              "textureId": "platformer-chars-tex",
              "width": 1.0,
              "height": 1.0,
              "pivotX": 0.5,
              "pivotY": 0.5,
              "region": "char00"
            },
            "rigidBody": {
              "type": "dynamic",
              "gravityScale": 1.2,
              "linearDamping": 0.0,
              "angularDamping": 0.1,
              "fixedRotation": true
            },
            "boxCollider": {
              "width": 0.8,
              "height": 0.8,
              "offsetX": 0,
              "offsetY": 0,
              "isSensor": false,
              "restitution": 0,
              "friction": 0.5
            },
            "script": {
              "src": "// Platformer Controller\nclass PlatformerController extends ScriptComponent {\n  speed = 7;\n  jumpForce = 12;\n  acceleration = 15;\n  airAcceleration = 8;\n  coyoteTime = 0.15;\n  coyoteTimer = 0;\n\n  onUpdate(dt) {\n    const moveX =\n      (this.input.isKeyDown('ArrowRight') || this.input.isKeyDown('KeyD') ? 1 : 0) -\n      (this.input.isKeyDown('ArrowLeft')  || this.input.isKeyDown('KeyA') ? 1 : 0);\n\n    const vel = this.getVelocity();\n    const grounded = this.isGrounded();\n    \n    if (grounded) {\n      this.coyoteTimer = this.coyoteTime;\n    } else {\n      this.coyoteTimer -= dt;\n    }\n\n    // Smooth X movement\n    const accel = grounded ? this.acceleration : this.airAcceleration;\n    const newVelX = vel.x + (moveX * this.speed - vel.x) * accel * dt;\n    \n    this.setVelocity(newVelX, vel.y);\n\n    const wantsJump = this.input.isJustPressed('Space') || this.input.isJustPressed('ArrowUp') || this.input.isJustPressed('KeyW');\n    if (wantsJump && this.coyoteTimer > 0) {\n      this.setVelocity(newVelX, this.jumpForce);\n      this.coyoteTimer = 0; // Consume coyote time\n    }\n\n    // Death height check\n    if (this.transform && this.transform.y < -10) {\n       this.setPosition(-8, 2);\n       this.setVelocity(0, 0);\n    }\n  }\n}\nexport default PlatformerController;",
