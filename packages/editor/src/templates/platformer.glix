            "script": {
              "src": "class Coin extends ScriptComponent {\n  collected = false;\n  onCollision(otherId) {\n    // Guard first: onCollision can fire on consecutive fixed steps before\n    // destroy() takes the coin out of the world \u2014 without this, one pickup\n    // plays the sound twice (and would score twice).\n    if (this.collected) return;\n    if (this.world.getName(otherId) === 'Player') {\n      this.collected = true;\n      this.audio.playSound('pickup');\n      this.destroy();\n    }\n  }\n}\nexport default Coin;",
