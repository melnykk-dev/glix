              "height": 0.8,
              "isSensor": true
            },
            "script": {
              "src": "class Ghost extends ScriptComponent {\n  timer = 0;\n  onUpdate(dt) {\n    this.timer += dt;\n    this.setVelocity(Math.sin(this.timer * 0.8) * 2, 0);\n  }\n  onCollision(otherId) {\n    if (this.world.getName(otherId) === 'Player') {\n      this.physics.teleport(otherId, -8, 2);\n      this.physics.setVelocity(otherId, 0, 0);\n    }\n  }\n}\nexport default Ghost;",
