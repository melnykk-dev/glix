        },
        "sortingLayer": {
          "layer": 1,
          "orderInLayer": 0,
          "ySort": false
        }
      },
      "id": "bullet"
    }
  },
  "scenes": {
    "main": {
      "id": "main",
      "name": "Main Scene",
      "entities": [
        {
          "id": "background",
          "name": "Starfield",
          "components": {
            "transform": {
              "x": 0,
              "y": 0,
              "rotation": 0,
              "scaleX": 1,
              "scaleY": 1
            },
            "sprite": {
              "textureId": "bg-stars",
              "width": 24,
              "height": 18,
              "pivotX": 0.5,
              "pivotY": 0.5
            },
            "sortingLayer": {
              "layer": -1,
              "orderInLayer": 0,
              "ySort": false
            }
          }
        },
        {
          "id": "player",
          "name": "Player",
          "components": {
            "transform": {
              "x": 0,
              "y": -4,
              "rotation": 0,
              "scaleX": 1,
              "scaleY": 1
            },
            "sprite": {
              "textureId": "player-ship",
              "width": 1.32,
              "height": 1.0,
              "pivotX": 0.5,
              "pivotY": 0.5
            },
            "rigidBody": {
              "type": "kinematic",
              "gravityScale": 0
            },
            "boxCollider": {
              "width": 1,
              "height": 1,
              "isSensor": false
            },
            "script": {
              "src": "class PlayerController extends ScriptComponent {\n  speed = 8;\n  fireCooldown = 0.2;\n  cooldown = 0;\n\n  onUpdate(dt) {\n    this.cooldown = Math.max(0, this.cooldown - dt);\n    const moveX =\n      (this.input.isKeyDown('ArrowRight') || this.input.isKeyDown('KeyD') ? 1 : 0) -\n      (this.input.isKeyDown('ArrowLeft')  || this.input.isKeyDown('KeyA') ? 1 : 0);\n    const moveY =\n      (this.input.isKeyDown('ArrowUp')    || this.input.isKeyDown('KeyW') ? 1 : 0) -\n      (this.input.isKeyDown('ArrowDown')  || this.input.isKeyDown('KeyS') ? 1 : 0);\n\n    this.setVelocity(moveX * this.speed, moveY * this.speed);\n\n    // Edge-triggered \"fire\" action (Space / F / click / touch B / gamepad\n    // button 2) + a cooldown: the old isMousePressed check fired once per\n    // fixed step while the click was down, so one click on a slow frame\n    // fired the laser ~5x. One press is one shot now, even when a slow\n    // frame runs several fixed steps while the press edge is live.\n    if (this.cooldown <= 0 && this.isActionJustPressed('fire')) {\n      this.cooldown = this.fireCooldown;\n      this.fire();\n    }\n  }\n\n  fire() {\n    this.audio.playSound('sfx-laser');\n    const bulletId = this.world.createEntity();\n    this.world.setName(bulletId, 'Bullet');\n    this.world.addComponent(bulletId, 'transform', {\n      x: this.transform.x,\n      y: this.transform.y + 0.5,\n      rotation: 0,\n      scaleX: 1,\n      scaleY: 1\n    });\n    this.world.addComponent(bulletId, 'sprite', { textureId: 'laser-blue', width: 0.16, height: 0.9 });\n    this.world.addComponent(bulletId, 'sortingLayer', { layer: 1, orderInLayer: 0, ySort: false });\n    this.world.addComponent(bulletId, 'rigidBody', { type: 'dynamic', gravityScale: 0 });\n    this.world.addComponent(bulletId, 'boxCollider', { width: 0.16, height: 0.9, isSensor: true });\n    this.world.addComponent(bulletId, 'script', {\"src\": \"class Bullet extends ScriptComponent {\\n  onStart() {\\