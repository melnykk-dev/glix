        {
          "id": "spawner",
          "name": "EnemySpawner",
          "components": {
            "transform": {
              "x": 0,
              "y": 6
            },
            "script": {
              "src": "class Spawner extends ScriptComponent {\n  timer = 0;\n  interval = 1.0;\n\n  onUpdate(dt) {\n    this.timer += dt;\n    if (this.timer >= this.interval) {\n      this.timer = 0;\n      const enemyId = this.world.createEntity();\n      this.world.setName(enemyId, 'Enemy');\n      this.world.addComponent(enemyId, 'transform', { x: (Math.random() * 14) - 7, y: 10, rotation: 0, scaleX: 1, scaleY: 1 });\n      this.world.addComponent(enemyId, 'sprite', { textureId: 'enemy-black', width: 1.1, height: 1.0 });\n      this.world.addComponent(enemyId, 'sortingLayer', { layer: 1, orderInLayer: 0, ySort: false });\n      this.world.addComponent(enemyId, 'rigidBody', { type: 'dynamic', gravityScale: 0 });\n      this.world.addComponent(enemyId, 'boxCollider', { width: 1.1, height: 1.0, isSensor: true });\n      this.world.addComponent(enemyId, 'script', {\"src\": \"class Enemy extends ScriptComponent {\\n  onStart() {\\n    this.setVelocity(0, -4);\\n  }\\n  onUpdate(dt) {\\n    if (this.transform && this.transform.y < -10) {\\n      this.destroy();\\n    }\\n  }\\n}\\nexport default Enemy;\", \"compiledJs\": \"var __defProp = Object.defineProperty;\\nvar __getOwnPropDesc = Object.getOwnPropertyDescriptor;\\nvar __getOwnPropNames = Object.getOwnPropertyNames;\\nvar __hasOwnProp = Object.prototype.hasOwnProperty;\\nvar __export = (target, all) => {\\n  for (var name in all)\\n    __defProp(target, name, { get: all[name], enumerable: true });\\n};\\nvar __copyProps = (to, from, except, desc) => {\\n  if (from && typeof from === \\\"object\\\" || typeof from === \\\"function\\\") {\\n    for (let key of __getOwnPropNames(from))\\n      if (!__hasOwnProp.call(to, key) && key !== except)\\n        __defProp(to, key, { get: () => from[key], enumerable: !(desc = __getOwnPropDesc(from, key)) || desc.enumerable });\\n  }\\n  return to;\\n};\\nvar __toCommonJS = (mod) => __copyProps(__defProp({}, \\\"__esModule\\\", { value: true }), mod);\\nvar stdin_exports = {};\