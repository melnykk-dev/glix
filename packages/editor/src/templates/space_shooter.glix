{
  "version": "1.0.0",
  "meta": {
    "name": "Space Shooter",
    "resolution": {
      "width": 800,
      "height": 600
    }
  },
  "assets": {
    "bg-stars": {
      "id": "bg-stars",
      "type": "texture",
      "name": "Starfield background (Kenney Space Shooter)",
      "mimeType": "image/png",
      "data": "data:image/png;base64,"
    },
    "player-ship": {
      "id": "player-ship",
      "type": "texture",
      "name": "Player ship blue",
      "mimeType": "image/png",
      "data": "data:image/png;base64,"
    },
    "enemy-black": {
      "id": "enemy-black",
      "type": "texture",
      "name": "Enemy ship black",
      "mimeType": "image/png",
      "data": "data:image/png;base64,"
    },
    "laser-blue": {
      "id": "laser-blue",
      "type": "texture",
      "name": "Blue laser",
      "mimeType": "image/png",
      "data": "data:image/png;base64,"
    },
    "meteor-brown": {
      "id": "meteor-brown",
      "type": "texture",
      "name": "Brown meteor (large)",
      "mimeType": "image/png",
      "data": "data:image/png;base64,"
    },
    "powerup-bolt": {
      "id": "powerup-bolt",
      "type": "texture",
      "name": "Blue bolt power-up",
      "mimeType": "image/png",
      "data": "data:image/png;base64,"
    },
    "sfx-laser": {
      "id": "sfx-laser",
      "type": "audio",
      "name": "Laser SFX (Kenney Space Shooter)",
      "mimeType": "audio/ogg",
      "data": "data:audio/ogg;base64,"
    }
  },
  "prefabs": {
    "bullet": {
      "name": "Bullet",
      "components": {
        "transform": {
          "x": 0,
          "y": 0,
          "rotation": 0,
          "scaleX": 0.2,
          "scaleY": 0.4
        },
        "sprite": {
          "textureId": "laser-blue",
          "width": 0.16,
          "height": 0.9,
          "pivotX": 0.5,
          "pivotY": 0.5
        },
        "rigidBody": {
          "type": "dynamic",
          "gravityScale": 0,
          "fixedRotation": true
        },
        "boxCollider": {
          "width": 0.16,
          "height": 0.9,
          "isSensor": true
        },
        "script": {
          "src": "class Bullet extends ScriptComponent {\n  speed = 15;\n  onStart() {\n    this.setVelocity(0, this.speed);\n  }\n  onUpdate(dt) {\n    if (this.transform && this.transform.y > 10) this.destroy();\n  }\n  onCollision(otherId) {\n    if (this.world.getName(otherId) === 'Enemy') {\n      this.world.removeEntity(otherId);\n      this.destroy();\n    }\n  }\n}\nexport default Bullet;",
